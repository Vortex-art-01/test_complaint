{
    "name": "complaints/module",
    "description": "Модуль «Жалобы»: зависимости только для тестов. На сервер не устанавливается.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Complaints\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Complaints\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
